<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Sun -->
    <path
        android:pathData="M 28,18 A 9,9 0 1,1 27.99,18 Z"
        android:fillColor="#EAE6FF" />

    <!-- Left Mountain Layer -->
    <path android:pathData="M -5,80 C 10,62 20,52 30,52 C 42,52 58,66 82,112 L -5,112 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="52"
                android:endX="30" android:endY="108">
                <item android:color="#B8A7FF" android:offset="0.0"/>
                <item android:color="#9580FF" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Front Mountain Layer -->
    <path android:pathData="M 0,112 C 28,86 54,42 74,42 C 88,42 98,52 112,66 L 112,112 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="74" android:startY="42"
                android:endX="74" android:endY="108">
                <item android:color="#FFFFFF" android:offset="0.0"/>
                <item android:color="#DCD6FF" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>